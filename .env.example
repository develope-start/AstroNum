DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
JWT_SECRET="change-this-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Optional additional administrators for the initial bootstrap only.
# After running `npm run seed:admin`, manage them from /admin/admins.
# 1.ADMIN_EMAIL="admin1@example.com"
# 1.ADMIN_PASSWORD="change-this-password"
# 2.ADMIN_EMAIL="admin2@example.com"
# 2.ADMIN_PASSWORD="change-this-password"

# ელფოსტის დადასტურებების გასაგზავნად (Resend.com)
APP_URL="http://localhost:3000"
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="Astro <noreply@example.com>"

# Required for AI-generated interpretations; set a valid Google AI Studio API key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Bank of Georgia eCommerce checkout. Keep the client secret only in the
# deployment secret store; never put real credentials in source control.
BOG_ENVIRONMENT="sandbox"
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_CALLBACK_URL="https://your-public-domain.example/api/billing/bog/callback"
BOG_CALLBACK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_THE_BANK_PROVIDED_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# TBC E-Commerce credentials. Keep them in the Vercel secret store.
TBC_DEVELOPER_API_KEY=""
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""
TBC_API_BASE_URL="https://api.tbcbank.ge"

# Photon-compatible geocoder base URL; can point to a self-hosted instance.
PHOTON_BASE_URL="https://photon.komoot.io"

# Optional self-hosted LibreTranslate/Argos Translate provider.
# Leave empty to use the built-in Georgian library without external latency.
LIBRETRANSLATE_URL="http://localhost:5000"
LIBRETRANSLATE_API_KEY=""
LIBRETRANSLATE_VERSION="libretranslate-v1"
PERSIST_INTERPRETATION_LIBRARY="true"
