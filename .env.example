DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
JWT_SECRET="change-this-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Optional additional administrators for the initial bootstrap only.
# After running `npm run seed:admin`, manage them from /admin/admins.
# 1.ADMIN_EMAIL="admin1@example.com"
# 1.ADMIN_PASSWORD="change-this-password"
# 2.ADMIN_EMAIL="admin2@example.com"
# 2.ADMIN_PASSWORD="change-this-password"

# ელფოსტის დადასტურებების გასაგზავნად (Resend.com)
APP_URL="http://localhost:3000"
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="Astro <noreply@example.com>"

# Optional self-hosted LibreTranslate/Argos Translate provider.
# Leave empty to use the built-in Georgian library without external latency.
LIBRETRANSLATE_URL="http://localhost:5000"
LIBRETRANSLATE_API_KEY=""
LIBRETRANSLATE_VERSION="libretranslate-v1"
PERSIST_INTERPRETATION_LIBRARY="true"
